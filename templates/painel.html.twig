<div class="container-fluid">
  <div class="d-flex align-items-center mb-3">
    <h2 class="mb-0 d-flex align-items-center"><i class="ti ti-chart-bar me-1"></i> PCA <select class="form-select form-select-sm d-inline-block w-auto mx-1 pca-ano" aria-label="Exercício">
        {% for a in anos %}<option value="{{ url_base }}?exercicio={{ a }}"{{ a == exercicio ? ' selected' : '' }}>{{ a }}</option>{% endfor %}
      </select> - Painel</h2>
    <a class="btn btn-outline-secondary ms-auto" href="{{ url_lista }}"><i class="ti ti-list"></i> Contratações</a>
  </div>
  <div class="row row-cards mb-3">
    {% set cartoes = [
      ['Contratações ativas', total.qtd, 'Manter + Avaliar'],
      ['Valor Anual', call('GlpiPlugin\\Pca\\Calculo::reais', [total.anual]), percentual is not null ? (percentual|number_format(1, ',', '.') ~ '% da estimativa do PCA') : ''],
      ['Valor Global', call('GlpiPlugin\\Pca\\Calculo::reais', [total.global]), ''],
      ['Marcadas para remover', removidas.qtd, call('GlpiPlugin\\Pca\\Calculo::reais', [removidas.anual]) ~ ' no ano'],
      ['Decisão pendente (Avaliar)', avaliar, ''],
      ['Com pendência', pendentes, 'de preenchimento'],
      ['Conferidas pela área', conferidas, 'de ' ~ total.qtd],
    ] %}
    {% for c in cartoes %}
      <div class="col-sm-6 col-lg-3">
        <div class="card"><div class="card-body">
          <div class="subheader">{{ c[0] }}</div>
          <div class="h1 mb-1">{{ c[1] }}</div>
          <div class="text-secondary">{{ c[2] }}</div>
        </div></div>
      </div>
    {% endfor %}
  </div>
  <div class="row row-cards">
    {% for titulo, linhas in tabelas %}
      <div class="col-lg-6">
        <div class="card mb-3">
          <div class="card-header"><h3 class="card-title">{{ titulo }}</h3></div>
          <div class="table-responsive">
            <table class="table table-vcenter card-table table-sm">
              <thead><tr><th></th><th class="text-end">Qtde.</th><th class="text-end">Valor Anual</th><th class="text-end">Valor Global</th><th style="width:22%"></th></tr></thead>
              <tbody>
                {% for l in linhas %}
                  <tr>
                    <td>{{ l.chave }}</td>
                    <td class="text-end">{{ l.qtd }}</td>
                    <td class="text-end">{{ call('GlpiPlugin\\Pca\\Calculo::reais', [l.anual]) }}</td>
                    <td class="text-end">{{ call('GlpiPlugin\\Pca\\Calculo::reais', [l.global]) }}</td>
                    <td><div class="progress progress-sm"><div class="progress-bar" style="width: {{ total.anual > 0 ? (l.anual / total.anual * 100)|round : 0 }}%"></div></div></td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>
